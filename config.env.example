# ───────── Login ─────────
# Option A (VPS/Docker): leave empty, run `npm run qr`, scan QR once. Session is kept in ./session
# Option B (Render/Railway etc.): run `npm run session` locally after login and paste the output here
ASENA_SESSION=""
# Option C: link by pairing code instead of QR (digits only, with country code, e.g. 919876543210)
PAIR_NUMBER=""

# ───────── Core ─────────
WORK_TYPE="private"          # private = only you | public = others can use commands marked public
HANDLERS="^[.!;]"            # command prefix characters
SUDO=""                      # extra owner numbers, comma separated, e.g. 919876543210,911234567890
NO_ONLINE="true"             # true = don't show "online" when the bot connects
SEND_READ="false"            # true = mark incoming messages as read
BOOT_MESSAGE="true"          # message yourself when the bot starts

# ───────── 24/7 / hosting ─────────
DATA_DIR=""                  # folder for session + data.json (point to a persistent volume, e.g. /data)
PORT="3000"
TZ="UTC"                     # your timezone for autobio, e.g. Asia/Kolkata
KEEP_ALIVE_URL=""            # your public URL; pinged every 10 min (Render free tier). Auto-uses RENDER_EXTERNAL_URL
LOG_LEVEL="silent"           # silent | error | warn | info | debug (Baileys logs)

# ───────── Features ─────────
ANTI_LINK="false"            # default for groups (per-group toggle: .antilink on/off)
AUTO_BIO="false"             # default (toggle: .autobio on/off)
AUTOBIO_MINUTES="10"
ALIVE_MESSAGE="default"      # supports {version}
AFK_MESSAGE="default"
ANTILINK_MESSAGE="default"
BAN_MESSAGE="default"
ADD_MESSAGE="default"
MUTE_MESSAGE="default"
UNMUTE_MESSAGE="default"
PROMOTE_MESSAGE="default"
DEMOTE_MESSAGE="default"
BLOCK_MESSAGE="default"
UNBLOCK_MESSAGE="default"
KICKME_MESSAGE="default"

# ───────── Optional API keys ─────────
WEATHER_API=""               # OpenWeatherMap (falls back to wttr.in when empty)
OMDB_API_KEY=""              # .movie  (free key: omdbapi.com)
REMOVE_BG_API_KEY=""         # .removebg
OCR_API_KEY=""               # .ocr (falls back to the public test key)
TRANSLATE_LANG="en"          # default target language for .trt
TTS_LANG="en"                # default language for .tts
YTDLP_PATH="yt-dlp"          # downloader binary
YTDLP_COOKIES=""             # optional cookies.txt path (helps with Instagram / age-gated videos)
