# ═══════════ SFL Bot v3.1: copy to config.env (local) or add each line as an Environment Variable (Render etc.)
# ⚠️  NEVER commit config.env to GitHub. Anyone who reads ASENA_SESSION can take over your WhatsApp.

# ───────── Login ─────────
PAIR_NUMBER=""               # digits only with country code, e.g. 919876543210 -> open https://YOUR-APP/pair for the code
ASENA_SESSION=""             # only AFTER linking: send .session to the bot and paste the result here (or use Upstash below)

# ───────── Core ─────────
WORK_TYPE="private"          # private = only you | public = others can use the public commands
HANDLERS="^[.!;]"            # command prefix characters
SUDO=""                      # extra owner numbers, comma separated
NO_ONLINE="true"             # true = don't show "online" when the bot connects
SEND_READ="false"
BOOT_MESSAGE="true"          # message yourself when the bot starts
BLOCK_CHAT=""                # chat JIDs the bot ignores (comma separated). Also: .blockchat / .unblockchat

# ───────── 24/7 hosting ─────────
DATA_DIR="/data"             # Docker image sets this. Point it at a persistent disk if you have one
PORT="3000"
KEEP_ALIVE_URL=""            # your public URL, pinged every 10 min (Render free tier). Auto-uses RENDER_EXTERNAL_URL
LOG_LEVEL="silent"           # silent | error | warn | info | debug (Baileys logs)
PRINT_SESSION="false"        # true = print ASENA_SESSION in the logs after linking (avoid: logs can be screenshotted)
PAIR_TOKEN=""                # optional password for the /pair page: /pair?token=...
YTDLP_AUTOUPDATE="true"      # update yt-dlp 25s after start (the Dockerfile does not)

# ───────── Remember login + data on free hosts (recommended for Render free) ─────────
# Free account at upstash.com -> Create Redis database -> copy the two REST values:
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ───────── SimSimi chatbot ─────────
SIMSIMI_API_KEY=""           # optional official key (workshop.simsimi.com). Without it, free fallback servers are used
SIMI_LANG="auto"             # auto = detect each message | or en, hi, id, es ...
SIMI_FILTER="true"           # ask SimSimi to filter rude answers (official API)
BRAINSHOP_BID=""             # optional extra fallback brain (brainshop.ai)
BRAINSHOP_KEY=""

# ───────── API keys ─────────
# Leave empty to use the defaults built into src/config.js. The OpenWeather, OMDb and wit.ai defaults are the
# SHARED keys from the old repos (not yours, may be rate-limited or revoked), so use your own when you can.
WEATHER_API=""               # OpenWeatherMap
OMDB_API_KEY=""              # omdbapi.com
WITAI_API=""                 # wit.ai (voice -> text for .voicy / .vtalk). The wit app decides the language
DEEPAI_API_KEY=""            # deepai.org (defaults to their public demo key)
REMOVE_BG_API_KEY=""         # remove.bg (no default)
OCR_API_KEY=""               # ocr.space (defaults to their public test key)

# ───────── Messages / misc ─────────
TRANSLATE_LANG="en"          # default language for .trt
TTS_LANG="en"                # default language for .tts
AUTO_BIO="false"
AUTOBIO_MINUTES="10"
ANTI_LINK="false"            # default for groups (per group: .antilink on|off)
TZ="UTC"                     # e.g. Asia/Kolkata (used by autobio)
ALIVE_MESSAGE="default"      # {version} placeholder
AFK_MESSAGE="default"
ANTILINK_MESSAGE="default"
BAN_MESSAGE="default"
ADD_MESSAGE="default"
MUTE_MESSAGE="default"
UNMUTE_MESSAGE="default"
PROMOTE_MESSAGE="default"
DEMOTE_MESSAGE="default"
BLOCK_MESSAGE="default"
UNBLOCK_MESSAGE="default"
KICKME_MESSAGE="default"

# ───────── Dangerous: off unless you really want it ─────────
ALLOW_TERM="false"           # true = .term shell command for YOUR account only
